{
  "name": "simple-browser",
  "productName": "Simple Browser",
  "version": "0.11.0",
  "description": "A simple, sandboxed Windows browser with full-screen mode and consent-based page recording.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/unit/*.test.js\"",
    "smoke": "node tests/smoke/launch.js",
    "test:packaged": "node tests/packaged/check.js",
    "audit:prod": "npm audit --omit=dev",
    "dist": "electron-builder --win nsis portable --x64"
  },
  "author": "Mohanavadivelu",
  "build": {
    "appId": "com.mohanavadivelu.simplebrowser",
    "productName": "Simple Browser",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "Simple-Browser-${version}-portable.exe"
    },
    "artifactName": "Simple-Browser-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Mohanavadivelu",
        "repo": "browser"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "grantFileProtocolExtraPrivileges": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.20.3",
    "electron-updater": "6.8.11"
  }
}
